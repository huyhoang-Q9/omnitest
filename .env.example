# Sao chép thành .env và điền giá trị. Không commit file .env.
OMNITEST_ENV=development
OMNITEST_DATABASE_URL=postgresql+asyncpg://omnitest:CHANGE_ME@127.0.0.1:5432/omnitest
OMNITEST_REDIS_URL=redis://127.0.0.1:6379/0
# Sinh bằng: uv run omnitest-api gen-master-key
OMNITEST_MASTER_KEY=
# false chỉ khi chạy local qua http
OMNITEST_COOKIE_SECURE=true
# Nơi lưu ảnh chụp, trace của lần chạy
OMNITEST_ARTIFACTS_DIR=./artifacts/runs
# Tùy chọn: Chromium có sẵn trên máy khi chưa chạy "playwright install chromium"
# OMNITEST_CHROMIUM_EXECUTABLE=/duong/dan/chromium
# Trợ lý AI (tùy chọn, tắt mặc định). Khi bật, Admin từng dự án vẫn phải đồng ý gửi dữ liệu của dự án.
# OMNITEST_AI_PROVIDER=anthropic            # none | anthropic | openai_compatible
# OMNITEST_AI_API_KEY=                      # đặt qua secret của máy chủ, không commit
# OMNITEST_AI_MODEL=claude-sonnet-5-5
# OMNITEST_AI_BASE_URL=                     # bắt buộc với openai_compatible, VD http://127.0.0.1:11434/v1 (Ollama)
# Sandbox chạy script code pytest/Playwright (tùy chọn, tắt mặc định). Worker cần Docker và image sandbox;
# Admin từng dự án vẫn phải bật "cho phép script code". Đọc docs/sandbox.md trước khi bật.
# OMNITEST_SANDBOX_ENABLED=true
# OMNITEST_SANDBOX_IMAGE=omnitest-sandbox:latest
# OMNITEST_SANDBOX_CPUS=1
# OMNITEST_SANDBOX_MEMORY_MB=1024
# OMNITEST_SANDBOX_PIDS_LIMIT=256
# Chỉ dùng cho Docker Compose
POSTGRES_PASSWORD=
