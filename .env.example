# Sao chép thành .env và điền giá trị. Không commit file .env.
OMNITEST_ENV=development
OMNITEST_DATABASE_URL=postgresql+asyncpg://omnitest:CHANGE_ME@127.0.0.1:5432/omnitest
OMNITEST_REDIS_URL=redis://127.0.0.1:6379/0
# Sinh bằng: uv run omnitest-api gen-master-key
OMNITEST_MASTER_KEY=
# false chỉ khi chạy local qua http
OMNITEST_COOKIE_SECURE=true
# Chỉ dùng cho Docker Compose
POSTGRES_PASSWORD=
